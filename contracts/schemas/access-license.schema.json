{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "access-license.schema.json",
  "title": "Pro_Adherence access and license metadata",
  "$defs": {
    "access_class": {
      "type": "string",
      "enum": [
        "public",
        "project-internal",
        "restricted-license",
        "secret"
      ],
      "description": "Access classes fixed by TECHNICAL_ARCHITECTURE §8.7."
    },
    "permission": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "unknown"
      ]
    },
    "license_status": {
      "type": "string",
      "enum": [
        "confirmed",
        "unknown",
        "not-applicable"
      ]
    },
    "publication_permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "raw_text",
        "derived"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/permission"
        },
        "raw_text": {
          "$ref": "#/$defs/permission"
        },
        "derived": {
          "$ref": "#/$defs/permission"
        }
      }
    },
    "access_license_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_class",
        "license_class",
        "license_status",
        "publication_permissions"
      ],
      "properties": {
        "access_class": {
          "$ref": "#/$defs/access_class"
        },
        "license_class": {
          "type": "string",
          "minLength": 1,
          "description": "Provider/project-defined license class or 'unknown'; not silently inferred."
        },
        "license_status": {
          "$ref": "#/$defs/license_status"
        },
        "license_evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Pointer to terms, source export metadata, or other evidence supporting the classification."
        },
        "publication_permissions": {
          "$ref": "#/$defs/publication_permissions"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "license_status": {
                "const": "unknown"
              }
            },
            "required": [
              "license_status"
            ]
          },
          "then": {
            "properties": {
              "publication_permissions": {
                "properties": {
                  "raw_text": {
                    "not": {
                      "const": "allow"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "access_class": {
                "const": "secret"
              }
            },
            "required": [
              "access_class"
            ]
          },
          "then": {
            "properties": {
              "publication_permissions": {
                "properties": {
                  "metadata": {
                    "const": "deny"
                  },
                  "raw_text": {
                    "const": "deny"
                  },
                  "derived": {
                    "const": "deny"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$ref": "#/$defs/access_license_metadata"
}
