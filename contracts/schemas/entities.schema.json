{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entities.schema.json",
  "title": "Pro_Adherence canonical entity contracts",
  "$defs": {
    "publication_date": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "precision"
          ],
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}$"
            },
            "precision": {
              "const": "year"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "precision"
          ],
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            "precision": {
              "const": "month"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "precision"
          ],
          "properties": {
            "value": {
              "type": "string",
              "format": "date"
            },
            "precision": {
              "const": "day"
            }
          }
        }
      ]
    },
    "external_id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "value_normalized"
      ],
      "properties": {
        "namespace": {
          "$ref": "ids.schema.json#/$defs/external_namespace"
        },
        "value_normalized": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_article_id",
        "title_display",
        "publication_date",
        "document_type",
        "language",
        "access_license",
        "record_status",
        "created_in_resolution_version"
      ],
      "properties": {
        "canonical_article_id": {
          "$ref": "ids.schema.json#/$defs/canonical_article_id"
        },
        "title_display": {
          "type": [
            "string",
            "null"
          ]
        },
        "abstract_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "abstract_artifact_pointer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "publication_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/publication_date"
            },
            {
              "type": "null"
            }
          ]
        },
        "document_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "venue_id": {
          "anyOf": [
            {
              "$ref": "ids.schema.json#/$defs/venue_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "access_license": {
          "$ref": "access-license.schema.json#/$defs/access_license_metadata"
        },
        "record_status": {
          "type": "string",
          "minLength": 1
        },
        "created_in_resolution_version": {
          "$ref": "ids.schema.json#/$defs/version_ref"
        },
        "superseded_by": {
          "anyOf": [
            {
              "$ref": "ids.schema.json#/$defs/canonical_article_id"
            },
            {
              "type": "null"
            }
          ],
          "deprecated": true,
          "description": "Legacy one-to-one shortcut retained for compatibility. Deprecated for complete identity history; use identity_resolution_event successor_ids."
        },
        "identity_history_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "ids.schema.json#/$defs/identity_resolution_event_id"
          },
          "description": "Versioned identity-resolution events that retain alias/merge/split/supersession history."
        }
      }
    },
    "article_external_id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_article_id",
        "namespace",
        "value_normalized",
        "source_record_id",
        "confidence",
        "valid_from"
      ],
      "properties": {
        "canonical_article_id": {
          "$ref": "ids.schema.json#/$defs/canonical_article_id"
        },
        "namespace": {
          "$ref": "ids.schema.json#/$defs/external_namespace"
        },
        "value_normalized": {
          "type": "string",
          "minLength": 1
        },
        "source_record_id": {
          "$ref": "ids.schema.json#/$defs/source_record_id"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "valid_from": {
          "$ref": "ids.schema.json#/$defs/version_ref"
        },
        "valid_to": {
          "anyOf": [
            {
              "$ref": "ids.schema.json#/$defs/version_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "article_source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_id",
        "source_id",
        "raw_artifact_id",
        "source_native_id",
        "original_metadata_payload_pointer",
        "parsed_fields",
        "retrieval_timestamp"
      ],
      "properties": {
        "source_record_id": {
          "$ref": "ids.schema.json#/$defs/source_record_id"
        },
        "source_id": {
          "$ref": "ids.schema.json#/$defs/source_id"
        },
        "raw_artifact_id": {
          "$ref": "ids.schema.json#/$defs/raw_artifact_id"
        },
        "source_native_id": {
          "type": "string",
          "minLength": 1
        },
        "original_metadata_payload_pointer": {
          "type": "string",
          "minLength": 1
        },
        "parsed_fields": {
          "type": "object"
        },
        "retrieval_timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_author_id",
        "display_name",
        "identity_status",
        "resolution_version"
      ],
      "properties": {
        "canonical_author_id": {
          "$ref": "ids.schema.json#/$defs/canonical_author_id"
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "orcid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
        },
        "identity_status": {
          "type": "string",
          "enum": [
            "asserted",
            "resolved",
            "ambiguous"
          ]
        },
        "resolution_version": {
          "$ref": "ids.schema.json#/$defs/version_ref"
        },
        "identity_history_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "ids.schema.json#/$defs/identity_resolution_event_id"
          },
          "description": "Versioned identity-resolution events that retain alias/merge/split/supersession history."
        }
      }
    },
    "authorship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorship_id",
        "canonical_article_id",
        "author_position",
        "original_author_string",
        "source_record_ids"
      ],
      "properties": {
        "authorship_id": {
          "$ref": "ids.schema.json#/$defs/authorship_id"
        },
        "canonical_article_id": {
          "$ref": "ids.schema.json#/$defs/canonical_article_id"
        },
        "canonical_author_id": {
          "$ref": "ids.schema.json#/$defs/canonical_author_id"
        },
        "unresolved_author_identity_id": {
          "$ref": "ids.schema.json#/$defs/unresolved_author_identity_id"
        },
        "author_position": {
          "type": "integer",
          "minimum": 1
        },
        "corresponding": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "original_author_string": {
          "type": "string",
          "minLength": 1
        },
        "source_record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "ids.schema.json#/$defs/source_record_id"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "canonical_author_id"
          ],
          "not": {
            "required": [
              "unresolved_author_identity_id"
            ]
          }
        },
        {
          "required": [
            "unresolved_author_identity_id"
          ],
          "not": {
            "required": [
              "canonical_author_id"
            ]
          }
        }
      ]
    },
    "affiliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_affiliation_id",
        "preferred_name",
        "identity_status"
      ],
      "properties": {
        "canonical_affiliation_id": {
          "$ref": "ids.schema.json#/$defs/canonical_affiliation_id"
        },
        "preferred_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "country_region": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/external_id"
          }
        },
        "identity_status": {
          "type": "string",
          "enum": [
            "asserted",
            "resolved",
            "ambiguous"
          ]
        },
        "identity_history_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "ids.schema.json#/$defs/identity_resolution_event_id"
          },
          "description": "Versioned identity-resolution events that retain alias/merge/split/supersession history."
        }
      }
    },
    "author_affiliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorship_id",
        "original_affiliation_string",
        "source_record_ids"
      ],
      "properties": {
        "authorship_id": {
          "$ref": "ids.schema.json#/$defs/authorship_id"
        },
        "canonical_affiliation_id": {
          "$ref": "ids.schema.json#/$defs/canonical_affiliation_id"
        },
        "unresolved_affiliation_id": {
          "$ref": "ids.schema.json#/$defs/unresolved_affiliation_id"
        },
        "original_affiliation_string": {
          "type": "string",
          "minLength": 1
        },
        "source_record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "ids.schema.json#/$defs/source_record_id"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "canonical_affiliation_id"
          ],
          "not": {
            "required": [
              "unresolved_affiliation_id"
            ]
          }
        },
        {
          "required": [
            "unresolved_affiliation_id"
          ],
          "not": {
            "required": [
              "canonical_affiliation_id"
            ]
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "display_name"
      ],
      "properties": {
        "source_id": {
          "$ref": "ids.schema.json#/$defs/source_id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "venue_id",
        "display_name"
      ],
      "properties": {
        "venue_id": {
          "$ref": "ids.schema.json#/$defs/venue_id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "external_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/external_id"
          }
        }
      }
    },
    "citation_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citing_article_id",
        "edge_source",
        "observation_version",
        "resolution_method",
        "confidence",
        "raw_evidence_pointer"
      ],
      "properties": {
        "citing_article_id": {
          "$ref": "ids.schema.json#/$defs/canonical_article_id"
        },
        "cited_article_id": {
          "$ref": "ids.schema.json#/$defs/canonical_article_id"
        },
        "external_target_id": {
          "$ref": "#/$defs/external_id"
        },
        "edge_source": {
          "$ref": "ids.schema.json#/$defs/source_id"
        },
        "observation_version": {
          "$ref": "ids.schema.json#/$defs/version_ref"
        },
        "resolution_method": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "raw_evidence_pointer": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "cited_article_id"
          ],
          "not": {
            "required": [
              "external_target_id"
            ]
          }
        },
        {
          "required": [
            "external_target_id"
          ],
          "not": {
            "required": [
              "cited_article_id"
            ]
          }
        }
      ]
    },
    "identity_resolution_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "ids.schema.json#/$defs/source_record_id"
          }
        },
        "artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "ids.schema.json#/$defs/artifact_id"
          }
        },
        "run_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "ids.schema.json#/$defs/run_id"
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "source_record_ids"
          ]
        },
        {
          "required": [
            "artifact_ids"
          ]
        },
        {
          "required": [
            "run_ids"
          ]
        },
        {
          "required": [
            "evidence_refs"
          ]
        }
      ]
    },
    "identity_resolution_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "identity_resolution_event_id",
        "entity_type",
        "event_type",
        "predecessor_ids",
        "successor_ids",
        "resolution_version",
        "method",
        "reason",
        "evidence",
        "created_at"
      ],
      "properties": {
        "record_type": {
          "const": "identity_resolution_event"
        },
        "identity_resolution_event_id": {
          "$ref": "ids.schema.json#/$defs/identity_resolution_event_id"
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "article",
            "author",
            "affiliation"
          ]
        },
        "event_type": {
          "type": "string",
          "enum": [
            "alias",
            "merge",
            "split",
            "supersession"
          ]
        },
        "predecessor_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "ids.schema.json#/$defs/uuid_v7"
          }
        },
        "successor_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "ids.schema.json#/$defs/uuid_v7"
          }
        },
        "resolution_version": {
          "$ref": "ids.schema.json#/$defs/immutable_version_ref"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/identity_resolution_evidence"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "alias"
              }
            },
            "required": [
              "event_type"
            ]
          },
          "then": {
            "properties": {
              "predecessor_ids": {
                "minItems": 1,
                "maxItems": 1
              },
              "successor_ids": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "merge"
              }
            },
            "required": [
              "event_type"
            ]
          },
          "then": {
            "properties": {
              "predecessor_ids": {
                "minItems": 2
              },
              "successor_ids": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "split"
              }
            },
            "required": [
              "event_type"
            ]
          },
          "then": {
            "properties": {
              "predecessor_ids": {
                "minItems": 1,
                "maxItems": 1
              },
              "successor_ids": {
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "supersession"
              }
            },
            "required": [
              "event_type"
            ]
          },
          "then": {
            "properties": {
              "predecessor_ids": {
                "minItems": 1,
                "maxItems": 1
              },
              "successor_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "identity_resolution_history_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "events"
      ],
      "properties": {
        "record_type": {
          "const": "identity_resolution_history_bundle"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identity_resolution_event"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/article"
    },
    {
      "$ref": "#/$defs/article_external_id"
    },
    {
      "$ref": "#/$defs/article_source_record"
    },
    {
      "$ref": "#/$defs/author"
    },
    {
      "$ref": "#/$defs/authorship"
    },
    {
      "$ref": "#/$defs/affiliation"
    },
    {
      "$ref": "#/$defs/author_affiliation"
    },
    {
      "$ref": "#/$defs/source"
    },
    {
      "$ref": "#/$defs/venue"
    },
    {
      "$ref": "#/$defs/citation_edge"
    },
    {
      "$ref": "#/$defs/identity_resolution_event"
    },
    {
      "$ref": "#/$defs/identity_resolution_history_bundle"
    }
  ]
}
